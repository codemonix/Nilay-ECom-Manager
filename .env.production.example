# Copy to `.env` next to docker-compose.prod.yml on the server and fill in
# real values. `docker compose` auto-loads `.env` from the project
# directory. Never commit the resulting `.env` file.

# Which build to run, from ghcr.io/codemonix/nilay-ecom-manager-{api,web}.
# "latest" tracks the most recent push to master; pin to a commit SHA
# (as tagged by .github/workflows/docker-publish.yml) to roll back or hold
# a version steady.
IMAGE_TAG=latest

# Local port the project's nginx/gateway container listens on (bound to
# 127.0.0.1 only, not exposed publicly). The host-level Nginx proxies
# nilay.codemonix.com to this port -- see deploy/host-nginx-*.conf. Pick a
# distinct port per project if this instance ends up hosting multiple sites.
APP_PORT=8081

# Baked into the web bundle at image build time -- must be the public URL
# the browser will use to reach the API, through the host Nginx + TLS.
VITE_API_URL=https://nilay.codemonix.com/api

CORS_ORIGIN=https://nilay.codemonix.com
LOG_LEVEL=info

# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Shopfa integration (external e-commerce platform).
SHOPFA_API_BASE_URL=https://www.nilayjewelry.com
SHOPFA_API_TOKEN=
SHOPFA_MOCK=false

MAX_UPLOAD_SIZE_MB=10

# --- scripts/backup-cron.sh ---
# Credentials used to call the authenticated backup endpoints
# (GET /api/settings/backup, /api/settings/data-backup). Prefer a dedicated
# account with only the Settings permission over a personal admin login.
BACKUP_ADMIN_EMAIL=
BACKUP_ADMIN_PASSWORD=
# Where backup files are written on the host (outside any Docker volume).
BACKUP_DIR=/opt/nilay-ecom-manager/backups
# How many days of local backups to keep.
BACKUP_RETENTION_DAYS=14
