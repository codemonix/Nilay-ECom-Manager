PORT=4000
MONGODB_URI=mongodb://localhost:27020/business_ops
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Secret used to sign login JWTs. Generate a long random value for real
# deployments, e.g. `openssl rand -hex 32`.
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=8h

# Shopfa integration (external e-commerce platform, source of truth for
# customers/orders/products). Set SHOPFA_MOCK=true to run without real
# Shopfa credentials using realistic in-memory mock data.
SHOPFA_API_BASE_URL=https://www.nilayjewelry.com
SHOPFA_API_TOKEN=
SHOPFA_MOCK=true

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
