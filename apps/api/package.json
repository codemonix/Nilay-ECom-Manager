{
  "name": "@complaint-system/api",
  "version": "1.0.0",
  "private": true,
  "description": "Internal business operations API. V1 implements Complaint / Case Management.",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --require dotenv/config src/server.ts",
    "build": "tsc -p .",
    "start": "node -r dotenv/config dist/src/server.js",
    "seed": "ts-node --transpile-only -r dotenv/config scripts/seed.ts",
    "create-admin": "ts-node --transpile-only -r dotenv/config scripts/createAdmin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@complaint-system/shared": "*",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "multer": "^2.3.0",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "mongodb-memory-server": "^10.1.2",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^5.0.0"
  }
}
