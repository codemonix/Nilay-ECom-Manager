# Root-level example. Each app also has its own .env.example (apps/api, apps/web).
# Copy the per-app files to .env and adjust values for your machine.

# --- apps/api ---
PORT=4000
MONGODB_URI=mongodb://localhost:27020/business_ops
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change_me_in_production
LOG_LEVEL=info

# Shopfa integration
SHOPFA_API_BASE_URL=https://api.shopfa.com
SHOPFA_API_TOKEN=
SHOPFA_MOCK=true

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --- apps/web ---
VITE_API_URL=http://localhost:4000/api
